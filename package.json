{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "if command -v bun >/dev/null 2>&1; then bun run build:mcp-ui; fi",
    "build": "next build",
    "build:mcp-ui": "bun run scripts/bundle-mcp-ui.ts --write",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "db:auth-generate": "better-auth generate --output src/db/schema.ts",
    "test": "bun test",
    "test:cleanup-calendar": "bun run scripts/cleanup-test-calendar.ts",
    "test:mcp": "bun run scripts/test-mcp-tools.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth-ui/core": "^1.7.33",
    "@better-auth-ui/react": "^1.7.33",
    "@better-auth/agent-auth": "^0.6.2",
    "@better-auth/cimd": "1.7.16",
    "@better-auth/mcp": "1.7.16",
    "@better-auth/oauth-provider": "1.7.16",
    "@date-fns/tz": "^1.5.0",
    "@daveyplate/better-auth-ui": "^3.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.3",
    "better-auth": "1.7.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.68.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "2.1.9",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.22",
    "@tailwindcss/turbopack": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@better-auth/core": "1.7.16",
    "@better-auth/telemetry": "1.7.16",
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "better-auth": "1.7.16",
    "better-call": "1.4.5",
    "drizzle-orm": "^0.45.4",
    "lodash": "^4.18.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "patchedDependencies": {
    "@better-auth/cli@1.4.22": "patches/@better-auth%2Fcli@1.4.22.patch"
  }
}
